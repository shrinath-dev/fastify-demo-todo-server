{

  "type": "object",
  "$id": "schema:dotenv",
  "required": ["MONGO_URL"],
  "properties": {
    "NODE_ENV": {
      "type": "string",
      "default": "developement"
    },
    "PORT":{
      "type": "integer",
      "default": 3000
    },
    "MONGO_URL": {
      "type": "string"
    },
    "JWT_SECRET": {
      "type": "string"
    },
    "JWT_EXPIRES_IN": {
      "type": "string",
      "default": "1h"
    }

  }
}
